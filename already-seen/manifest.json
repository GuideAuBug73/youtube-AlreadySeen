{
  "manifest_version": 3,
  "name": "AlreadySeen – Marquer comme vu sur YouTube",
  "short_name": "AlreadySeen",
  "version": "1.0.0",
  "description": "Marque une vidéo YouTube comme vue depuis le lecteur ou les vignettes, synchronisé avec l'historique et la barre rouge de votre compte.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "AlreadySeen",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/shared.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
